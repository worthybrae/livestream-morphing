FROM rust:1.86-bookworm AS builder
# Railway deployment is amd64; v2 enables hardware SIMD rounding/integer ops.
# Override with an empty value when building for another architecture.
ARG RUSTFLAGS="-C target-cpu=x86-64-v2"
ENV RUSTFLAGS=${RUSTFLAGS}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
    libavfilter-dev libavdevice-dev pkg-config libclang-dev python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY livestream-morphing-rs/Cargo.toml livestream-morphing-rs/Cargo.lock ./
RUN mkdir src && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release \
    && rm -f target/release/deps/livestream_morphing_rs*
COPY livestream-morphing-rs/src/ src/
COPY livestream-morphing-rs/assets/ assets/
RUN cargo test && cargo build --release
COPY artwork/stroke-memory/native/ /native/
RUN cargo test --manifest-path /native/Cargo.toml && cargo build --release --manifest-path /native/Cargo.toml

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libavcodec59 libavformat59 libavutil57 libswscale6 libavfilter8 \
    libavdevice59 libx264-164 ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY artwork/stroke-memory/requirements.txt /tmp/paint-requirements.txt
RUN python3 -m venv /opt/paint && /opt/paint/bin/pip install --no-cache-dir -r /tmp/paint-requirements.txt
COPY artwork/stroke-memory/live.py artwork/stroke-memory/render.py artwork/stroke-memory/adaptive.py artwork/stroke-memory/motion.py /opt/paint-worker/
COPY --from=builder /native/target/release/libstroke_study_raster.so /opt/paint-worker/libstroke_study_raster.so
ENV LOADED_RASTER=/opt/paint-worker/libstroke_study_raster.so PYTHONDONTWRITEBYTECODE=1
RUN adduser --system --no-create-home --shell /sbin/nologin morphing
COPY --from=builder /app/target/release/livestream-morphing-rs /usr/local/bin/morphing
USER morphing
EXPOSE 8080
ENV PORT=8080 PUBLIC_MODE=true ALLOWED_ORIGIN=https://worthyrae.com
CMD ["morphing"]
